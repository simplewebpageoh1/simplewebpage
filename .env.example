# Site URL (used for canonical URLs / SEO). Example:
# VITE_SITE_URL=https://simplewebpageoh.netlify.app
VITE_SITE_URL=

# Stripe (Checkout API via Netlify Function)
# Netlify Environment Variables (Server-side):
# - STRIPE_SECRET_KEY = your Stripe secret key (sk_live_...)
# - ENABLE_AUTOMATIC_TAX = true/false

# --- Lead automation (Contact form webhook) ---
# Netlify Forms Webhook -> /.netlify/functions/contact-lead
# Netlify Environment Variables (Server-side):
# - SENDGRID_API_KEY
# - LEAD_OWNER_EMAIL
# - EMAIL_FROM
# - ENABLE_LEAD_AUTOREPLY
# - GOOGLE_SHEETS_SPREADSHEET_ID
# - GOOGLE_SHEETS_RANGE
# - GOOGLE_SERVICE_ACCOUNT_EMAIL
# - GOOGLE_PRIVATE_KEY (use \n for newlines)

# Optional: client-side contact email
VITE_CONTACT_EMAIL=info@simplewebpageoh.com

# Header primary CTA (mobile + desktop)
# - checkout (default): show "Checkout" as the main header button when a selection exists
# - contact: show "Contact" as the main header button
VITE_HEADER_PRIMARY_CTA=checkout
